<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile | AUTH System</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css"/>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav class="teal darken-3">
    <div class="nav-wrapper">
        <a href="/dashboard/user" class="brand-logo">AUTH System</a>
        <ul class="right">
            <li><a href="/dashboard/user">Dashboard</a></li>
            <li><a href="#" data-logout>Cerrar sesión</a></li>
        </ul>
    </div>
</nav>

<div class="container page-container">
    <header class="page-header">
        <p class="page-eyebrow">Account settings</p>
        <h1 class="page-title">Mi cuenta</h1>
        <p class="page-subtitle">Actualiza tu información personal y revisa los datos de acceso asociados a tu usuario.</p>
    </header>

    <div class="card card-rounded">
        <div class="card-content">
            <span class="card-title">Información de perfil</span>
            <p class="card-description">Los cambios se aplican al perfil autenticado actualmente.</p>

            <form id="profileForm">
                <div class="profile-layout">
                    <aside class="profile-panel">
                        <img id="profilePreview" class="profile-img" src="https://cdn-icons-png.flaticon.com/512/149/149071.png" alt="Perfil">
                        <div class="profile-meta">
                            <strong id="emailText"></strong>
                            <span id="rolesText"></span>
                        </div>
                    </aside>

                    <div>
                        <div class="form-grid">
                            <div class="input-field">
                                <input id="name" type="text" required>
                                <label for="name">Nombres</label>
                            </div>

                            <div class="input-field">
                                <input id="lastName" type="text" required>
                                <label for="lastName">Apellidos</label>
                            </div>

                            <div class="input-field">
                                <input id="phoneNumber" type="text" required>
                                <label for="phoneNumber">Teléfono</label>
                            </div>

                            <div class="input-field">
                                <input id="birthdate" type="date" required>
                                <label for="birthdate" class="active">Fecha de nacimiento</label>
                            </div>

                            <div class="input-field">
                                <input id="url_profile" type="text">
                                <label for="url_profile">URL de perfil</label>
                            </div>

                            <div class="input-field">
                                <input id="adress" type="text">
                                <label for="adress">Dirección</label>
                            </div>
                        </div>

                        <div class="info-grid">
                            <div class="info-item">
                                <span class="info-label">Edad</span>
                                <span class="info-value" id="ageText"></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Estado</span>
                                <span class="info-value">Perfil activo</span>
                            </div>
                        </div>
                    </div>
                </div>

                <p id="message"></p>

                <button class="btn waves-effect waves-light teal darken-3" type="submit">
                    Guardar cambios
                    <i class="material-icons right">save</i>
                </button>
            </form>
        </div>
    </div>
</div>

<script src="/js/auth.js"></script>
<script src="/js/profile.js"></script>
</body>
</html>
